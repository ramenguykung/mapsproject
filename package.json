{
  "name": "wme-thailand-tambon",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:userscript": "node scripts/build-tambon-userscript.mjs",
    "syntax": "node --check tambon.user.script.js",
    "lint": "eslint tambon.user.script.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/tambon.user.script.test.js",
    "test:watch": "vitest tests/tambon.user.script.test.js",
    "verify:data": "vitest run tests/data-integrity.test.js",
    "check": "node --check tambon.user.script.js && eslint tambon.user.script.js && tsc --noEmit && vitest run tests/tambon.user.script.test.js && vitest run tests/data-integrity.test.js",
    "test:release": "node scripts/verify-tambon-userscript.mjs",
    "release:check": "npm run check && npm run test:release"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "javascript-obfuscator": "5.6.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wme-sdk-typings": "https://web-assets.waze.com/wme_sdk_docs/production/latest/wme-sdk-typings.tgz"
  }
}
